FROM python:3.11-alpine

ARG SUPERCRONIC_VERSION=v0.2.48
ARG SUPERCRONIC_URL=https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-amd64
ARG SUPERCRONIC_SHA1SUM=71b0d58cc53f6bd72cf2f293e09e294b79c666d8

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN addgroup -S app && adduser -S -G app -h /app app && \
    apk add --no-cache curl ca-certificates && \
    curl -fsSLo /usr/local/bin/supercronic "$SUPERCRONIC_URL" && \
    echo "${SUPERCRONIC_SHA1SUM}  /usr/local/bin/supercronic" | sha1sum -c - && \
    chmod 0755 /usr/local/bin/supercronic

WORKDIR /app

COPY --chown=app:app scripts/sync_shifts.py /app/scripts/sync_shifts.py
COPY --chown=app:app sync-crontab /app/crontab

USER app

CMD ["/usr/local/bin/supercronic", "/app/crontab"]
